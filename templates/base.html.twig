<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Your services assistant{% endblock %}</title>
        <link rel="icon" href="img/logo/favicon.ico">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <header class="header">
            <video class="cs-logo" autoplay loop muted playsinline>
                <source src="{{ asset('img/logo/logo.mp4') }}" type="video/mp4">
                <img src="{{ asset('img/logo/logo.png') }}" alt="Company Logo">
            </video>
            <div class="header-title">Your services assistant</div>
            <div class="header-user-action">
                <a href="{{ path('app_login') }}">Sign In</a>
                <a href="{{ path('app_register')}}">Sign Up</a>
            </div>
        </header>
        <content class="content">
            {% block body %}{% endblock %}
        </content>
        <footer class="footer">
            &copy; {{date}} ComService
        </footer>

    </body>
</html>
